# Skiff guest kernel: debug options merged on top of
# x86_64_defconfig + kvm_guest.config by scripts/build-kernel.sh.
# The script checks every line below against the final .config and stops if
# Kconfig dropped one (that happens silently when a dependency isn't met).
# All symbols verified against linux-6.18.58.

# --- Memory errors: use-after-free, out-of-bounds -------------------------
# e.g. touching an RX buffer after you freed it, indexing past the ring.
# Docs: Documentation/dev-tools/kasan.rst
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
# Leaks, e.g. buffers not freed on rmmod: cat /sys/kernel/debug/kmemleak
CONFIG_DEBUG_KMEMLEAK=y
# Corrupted list_head (double list_del, list node used after free)
CONFIG_DEBUG_LIST=y

# --- Concurrency -----------------------------------------------------------
# lockdep: lock-order inversions, and a lock taken both in IRQ context and
# with IRQs enabled. Docs: Documentation/locking/lockdep-design.rst
CONFIG_PROVE_LOCKING=y
# Sleeping (kmalloc(GFP_KERNEL), mutex_lock) while holding a spinlock or in IRQ
CONFIG_DEBUG_ATOMIC_SLEEP=y
# free_irq() calls your handler once more, with no real interrupt pending.
# Legacy virtio uses a shared INTx line, so the handler must check the ISR
# register and return IRQ_NONE when the interrupt isn't ours.
CONFIG_DEBUG_SHIRQ=y
# A busy loop that never yields (e.g. spinning on a device that never answers)
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# --- DMA -------------------------------------------------------------------
# Unmapping with the wrong size/direction, double unmap, missing
# dma_mapping_error(). Docs: Documentation/core-api/dma-api.rst, Part III
CONFIG_DMA_API_DEBUG=y

# --- gdb -------------------------------------------------------------------
# Full DWARF types for gdb, the lx-* helper scripts, symbols for data too.
# Docs: Documentation/process/debugging/gdb-kernel-debugging.rst
CONFIG_DEBUG_INFO_DWARF5=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_GDB_SCRIPTS=y
CONFIG_KALLSYMS_ALL=y
# No KASLR: the kernel runs at the addresses written in vmlinux
# CONFIG_RANDOMIZE_BASE is not set

# --- Observability inside the guest ---------------------------------------
CONFIG_DEBUG_FS=y
# pr_debug() in your module can be switched on at runtime
CONFIG_DYNAMIC_DEBUG=y
# zcat /proc/config.gz shows what the running kernel was built with
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- The experiment NIC ----------------------------------------------------
# kvm_guest.config makes virtio_net built-in (=y), which would grab the
# experiment NIC at boot. As a module it never loads on its own: the guest
# disk has no /lib/modules for this kernel. It stays buildable as the
# baseline driver for the v1.0 evaluation.
CONFIG_VIRTIO_NET=m
